# Wajib: API Key Google Gemini untuk AIsyah & Buat Soal Otomatis
GEMINI_API_KEY=isi_api_key_gemini_anda_di_sini

# Wajib untuk Login Google Resmi (dapatkan dari Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=isi_client_id_google_anda.apps.googleusercontent.com

# Opsional: ubah menjadi "true" HANYA jika ingin mengizinkan login Google di luar domain belajar.id (mis. @gmail.com)
NEXT_PUBLIC_ALLOW_ANY_GOOGLE_DOMAIN=false
